# =====================================================================
# Variáveis de ambiente de exemplo.
# Copie para `.env` (cp .env.example .env) antes de rodar fora do Docker.
# No docker-compose os valores padrão já estão definidos.
# =====================================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outbox
# Alternativamente, defina a URL completa (tem prioridade):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/outbox

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=orders.exchange
RABBITMQ_QUEUE=orders.created.queue
RABBITMQ_ROUTING_KEY=order.created

# ---------- API ----------
API_PORT=8080

# ---------- Worker (Outbox) ----------
OUTBOX_POLLING_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_DURATION_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BACKOFF_BASE_MS=2000
OUTBOX_RETRY_BACKOFF_MAX_MS=60000

# ---------- Consumer ----------
CONSUMER_PREFETCH=1

# ---------- Logs ----------
# Níveis: trace | debug | info | warn | error
LOG_LEVEL=info
# true para logs legíveis (pino-pretty); false para JSON puro.
LOG_PRETTY=false

# ---------- Simulações de falha (apenas demonstração) ----------
# Cenário 3: força ROLLBACK após persistir o pedido, antes da Outbox.
SIMULATE_API_FAILURE=false
# Cenário 4: derruba o worker após o confirm, antes de marcar PUBLISHED.
SIMULATE_CRASH_AFTER_CONFIRM=false
